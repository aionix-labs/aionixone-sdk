{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource",
  "description": "Unified declarative resource structure (service/resourceType/metadata/spec).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "description": "Declarative resource contract version.",
      "type": "string",
      "const": "v1"
    },
    "service": {
      "description": "Service namespace for declarative resolution.",
      "type": "string",
      "const": "openact"
    },
    "resourceType": {
      "description": "Declarative resource type identifier.",
      "type": "string",
      "const": "connection"
    },
    "metadata": {
      "$ref": "#/$defs/contracts.declarative.ResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/contracts.declarative.ConnectionSpec"
    }
  },
  "required": [
    "apiVersion",
    "service",
    "resourceType",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "contracts.declarative.ResourceMetadata": {
      "description": "Common metadata for all declarative resources.\n\n# Fields\n\n- `name`: Resource local identifier (resolver input for identity mapping)\n- `description`: Human-readable description\n- `tags`: Key-value pairs for filtering and organization\n- `annotations`: Key-value pairs for extended metadata (not used for filtering)\n- `providerRef`: The Provider the resource is filed under",
      "type": "object",
      "properties": {
        "name": {
          "description": "Resource name.\n\nThis is a service-scoped local identifier used by declarative identity mapping.\nThe final TRN resource path is resolver-derived and may compose additional\nnamespace context. Workspace filename matching, if required, is a loader/workspace\npolicy and not a contracts-level invariant.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "description": {
          "description": "Human-readable description of the resource.",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Tags for filtering and organization.\n\nTags are key-value pairs that can be used for:\n- Filtering resources in queries\n- Organizing resources by environment, team, etc.",
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_.-]+$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "description": "Annotations for extended metadata.\n\nUnlike tags, annotations are not used for filtering.\nThey're meant for storing additional metadata like:\n- Creation tool information\n- External system references\n- Custom metadata",
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_.-]+$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "providerRef": {
          "description": "The Provider this resource is filed under, as a ProviderHub Provider\nTRN of the resource's own tenant.\n\nIt only files the resource for filtering and display; it never\nchanges how the resource runs. A Provider resource carries none.",
          "anyOf": [
            {
              "$ref": "#/$defs/contracts.declarative.ResourceTrn"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "contracts.declarative.ResourceTrn": {
      "description": "A validated literal TRN reference — the final scalar value of every\ndeclarative reference field.",
      "type": "string",
      "x-aionix-reference": true
    },
    "contracts.declarative.ConnectionSpec": {
      "title": "ConnectionSpec",
      "description": "OpenAct connection platform fields plus one strict connector configuration.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string",
              "const": "http"
            },
            "config": {
              "$ref": "#/$defs/contracts.openact.HttpConnectionConfig"
            },
            "serviceAccountRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/contracts.authz.RuntimeServiceAccountTrn"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "materialRefs": {
              "$ref": "#/$defs/contracts.declarative.MaterialRefs"
            }
          },
          "required": [
            "variant",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string",
              "const": "sftp"
            },
            "config": {
              "$ref": "#/$defs/contracts.openact.SftpConnectionConfig"
            },
            "serviceAccountRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/contracts.authz.RuntimeServiceAccountTrn"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "materialRefs": {
              "$ref": "#/$defs/contracts.declarative.MaterialRefs"
            }
          },
          "required": [
            "variant",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string",
              "const": "smtp"
            },
            "config": {
              "$ref": "#/$defs/contracts.openact.SmtpConnectionConfig"
            },
            "serviceAccountRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/contracts.authz.RuntimeServiceAccountTrn"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "materialRefs": {
              "$ref": "#/$defs/contracts.declarative.MaterialRefs"
            }
          },
          "required": [
            "variant",
            "config"
          ],
          "additionalProperties": false
        }
      ]
    },
    "contracts.openact.HttpConnectionConfig": {
      "description": "HTTP connection configuration\n\nDefines the base URL for an HTTP endpoint.",
      "type": "object",
      "properties": {
        "baseUrl": {
          "description": "Base URL for all requests (e.g., \"https://api.example.com/v1\")",
          "type": "string"
        },
        "requestBinding": {
          "description": "Parameters applied after the Action parameters, before encoding.",
          "$ref": "#/$defs/contracts.openact.HttpConnectionBindingSpec",
          "default": {
            "headers": {},
            "query": {},
            "body": {}
          }
        },
        "followRedirects": {
          "description": "Whether to follow HTTP redirects",
          "type": "boolean",
          "default": true
        },
        "maxRedirects": {
          "description": "Maximum number of redirects to follow",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "baseUrl"
      ]
    },
    "contracts.openact.HttpConnectionBindingSpec": {
      "description": "Connection parameters share the Action value semantics; body parameters\nreplace complete top-level values instead of recursively merging them.",
      "type": "object",
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "query": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "body": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "contracts.openact.SftpConnectionConfig": {
      "description": "SFTP connection configuration\n\nProvides secure file transfer to remote servers via SSH/SFTP protocol.\nAll file operations are constrained to the specified `basePath` for security.",
      "type": "object",
      "properties": {
        "host": {
          "description": "SFTP server hostname or IP address",
          "type": "string"
        },
        "port": {
          "description": "SSH port number (default: 22)",
          "type": "integer",
          "format": "uint16",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "basePath": {
          "description": "Base directory for all operations (REQUIRED for security)\n\nAll paths in actions are relative to this base path.\nThis is a security boundary - operations cannot escape this directory.\n\nConstraints:\n- MUST be an absolute path (starts with `/`)\n- MUST NOT be `/` (root is forbidden)",
          "type": "string"
        },
        "timeoutSecs": {
          "description": "Connection timeout in seconds (default: 30)",
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "default": 30
        },
        "hostKeySha256": {
          "description": "Required SHA-256 fingerprint of the SSH server host key.\n\nCanonical form: `SHA256:` followed by the unpadded standard-base64\nencoding of the SHA-256 digest of the raw SSH host-key bytes.",
          "$ref": "#/$defs/contracts.openact.SftpHostKeySha256"
        },
        "login": {
          "description": "Required, explicitly selected SFTP credential binding.",
          "$ref": "#/$defs/contracts.openact.SftpLogin"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "basePath",
        "hostKeySha256",
        "login"
      ]
    },
    "contracts.openact.SftpHostKeySha256": {
      "description": "Canonical pinned SHA-256 identity of an SSH server host key.",
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]$"
    },
    "contracts.openact.SftpLogin": {
      "anyOf": [
        {
          "title": "Password",
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "username",
            "password"
          ]
        },
        {
          "title": "Private key",
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "privateKey": {
              "description": "Private key of an Ed25519, ECDSA or RSA key in the OpenSSH, PKCS#8,\nPKCS#1 or SEC1 PEM format or the PuTTY format. `ssh-keygen -p -f <key>`\nrewrites a key in the OpenSSH format.",
              "type": "string"
            },
            "passphrase": {
              "description": "Passphrase of an encrypted private key; an unencrypted key does not use it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "username",
            "privateKey"
          ]
        }
      ]
    },
    "contracts.openact.SmtpConnectionConfig": {
      "description": "SMTP connection configuration",
      "type": "object",
      "properties": {
        "host": {
          "description": "SMTP server host",
          "type": "string"
        },
        "port": {
          "description": "SMTP server port",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 587
        },
        "encryption": {
          "description": "Encryption mode",
          "$ref": "#/$defs/contracts.openact.EncryptionMode",
          "default": "startTls"
        },
        "timeoutSecs": {
          "description": "Connection timeout in seconds",
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "default": 30
        },
        "defaultFrom": {
          "description": "Default sender address",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "defaultReplyTo": {
          "description": "Default reply-to address",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tlsCaCertificates": {
          "description": "Additional PEM-encoded CA certificates trusted for this SMTP connection.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 8
        },
        "login": {
          "description": "Optional SMTP credentials. Absence explicitly selects anonymous SMTP.",
          "anyOf": [
            {
              "$ref": "#/$defs/contracts.openact.SmtpLogin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host"
      ]
    },
    "contracts.openact.EncryptionMode": {
      "description": "SMTP encryption mode",
      "oneOf": [
        {
          "title": "None",
          "description": "No encryption (port 25)",
          "type": "string",
          "const": "none"
        },
        {
          "title": "STARTTLS",
          "description": "STARTTLS - upgrade to TLS after connection (port 587)",
          "type": "string",
          "const": "startTls"
        },
        {
          "title": "TLS",
          "description": "Direct TLS connection (port 465)",
          "type": "string",
          "const": "tls"
        }
      ]
    },
    "contracts.openact.SmtpLogin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "username",
        "password"
      ]
    },
    "contracts.authz.RuntimeServiceAccountTrn": {
      "type": "string",
      "x-aionix-reference": true
    },
    "contracts.declarative.MaterialRefs": {
      "description": "Local names mapped to literal CredVault references. A single reference\nmay supply several fields; different names may select the same resource.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/contracts.declarative.ResourceTrn"
      }
    }
  }
}
